# FalkorDB is required for the submission. Start it with docker compose up -d.
GRAPH_BACKEND=falkordb
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6380
FALKORDB_GRAPH=returntrace
# For a remote database, set FALKORDB_URL instead of host/port.
# FALKORDB_URL=rediss://default:password@your-host:port
PORT=4317
HOST=127.0.0.1
# Optional adaptive LLM, using an OpenAI-compatible chat-completions endpoint.
# Without this, the adaptive evidence policy selects MCP tools with no API cost.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-20b
# LLM_MAX_ROUNDS=3
# Optional external ticket publishing (never called automatically by the agent).
# Token needs Issues read/write for the chosen repository.
# GITHUB_REPOSITORY=owner/repository
# GITHUB_TOKEN=
